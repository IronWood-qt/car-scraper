# Copy to .env and fill in what you want. .env is gitignored (same as
# targets.db/data/) - docker compose reads it automatically, no extra flag
# needed. Every value here is optional; the stack works with none set.
#
# All of these are also editable from the dashboard's Settings page, which
# takes priority over these env vars and needs no restart to apply. Use
# these instead only if you'd rather not have secrets in targets.db, or want
# them baked into the container without touching the UI first.

# Pushover (https://pushover.net) push notifications on new listings / price
# drops. Leave both unset to disable - send_pushover() silently no-ops.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# URL the Pushover push links to (e.g. your dashboard's LAN address, like
# http://192.168.1.50:8501). No default - there's no one-size-fits-all
# address once the dashboard is self-hosted per-user.
DASHBOARD_URL=

# The scraper container's loop interval (default 6h) and max pages per
# target (default 10) are Settings-page-only now, not env vars - see the
# Settings page.
